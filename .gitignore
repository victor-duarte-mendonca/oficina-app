target/
keys/
*.log
*.class
.idea/
*.iml
.DS_Store

# Nunca commitar chaves privadas!
keys/privateKey.pem
keys/publicKey.pem

# Terraform — state fica em S3, nada disso deve ser commitado.
# Regras amplas (**/) pegam state solto em qualquer diretório, não só infra/ — um
# terraform.tfstate gerado fora de infra/ já vazou uma vez para untracked.
**/*.tfstate
**/*.tfstate.*
**/*.tfvars
**/tfplan
infra/.terraform/
infra/*.pem

# Kubeconfig e artefatos efêmeros de acesso ao cluster — contêm credenciais do k3s
# (CA + client-cert/key) ou são lixo de patch gerado a cada sessão. Nunca commitar.
# Regras amplas para pegar kubeconfig, kubeconfig-raw, kubeconfig-local, *-patch.json, patch.json.
**/kubeconfig
**/kubeconfig-*
**/patch.json
**/*-patch.json
