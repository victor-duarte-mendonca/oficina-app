      ]
    },
    {
      "name": "7 — REQUISITO: Listagem ordenada da fila de trabalho",
      "item": [
        {
          "name": "Listar OS ativas → ordem por prioridade + antiguidade",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/work-orders", "host": ["{{baseUrl}}"], "path": ["admin", "work-orders"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const lista = pm.response.json();",
            "console.log('--- FILA DE TRABALHO ---');",
            "lista.forEach((o, i) => console.log((i + 1) + '. ' + o.orderNumber + '  ' + o.status));",
            "",
            "const prioridade = { IN_EXECUTION: 0, AWAITING_APPROVAL: 1, IN_DIAGNOSIS: 2, RECEIVED: 3 };",
            "pm.test('ordenado: Execucao > Aguardando Aprovacao > Diagnostico > Recebida', () => {",
            "  for (let i = 1; i < lista.length; i++) {",
            "    pm.expect(prioridade[lista[i].status]).to.be.at.least(prioridade[lista[i - 1].status]);",
            "  }",
            "});",
            "",
            "pm.test('dentro do mesmo status, mais antigas primeiro', () => {",
            "  for (let i = 1; i < lista.length; i++) {",
            "    if (lista[i].status === lista[i - 1].status) {",
            "      pm.expect(new Date(lista[i].createdAt).getTime())",
            "        .to.be.at.least(new Date(lista[i - 1].createdAt).getTime());",
            "    }",
            "  }",
            "});",
            "",
            "pm.test('nenhuma OS terminal aparece na fila ativa', () => {",
            "  const status = lista.map(o => o.status);",
            "  ['FINISHED', 'DELIVERED', 'CANCELLED'].forEach(s => pm.expect(status).to.not.include(s));",
            "});",
            "",
            "const total = pm.response.headers.get('X-Total-Count');",
            "pm.test('header X-Total-Count exposto', () => pm.expect(total).to.not.be.null);",
            "pm.collectionVariables.set('ativasAntes', Number(total));",
            "console.log('X-Total-Count:', total);"
          ] } }]
        }
      ]
    },
    {
      "name": "8 — REQUISITO: Exclusão lógica (não física)",
      "item": [
        {
          "name": "Concluir execução → FINISHED (dispara e-mail)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/work-orders/{{workOrderId}}/complete", "host": ["{{baseUrl}}"], "path": ["admin", "work-orders", "{{workOrderId}}", "complete"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('IN_EXECUTION → FINISHED', () => pm.expect(pm.response.json().status).to.eql('FINISHED'));"
          ] } }]
        },
        {
          "name": "Registrar entrega → DELIVERED (dispara e-mail)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/work-orders/{{workOrderId}}/deliver", "host": ["{{baseUrl}}"], "path": ["admin", "work-orders", "{{workOrderId}}", "deliver"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('FINISHED → DELIVERED', () => pm.expect(pm.response.json().status).to.eql('DELIVERED'));"
          ] } }]
        },
        {
          "name": "Fila ativa → a OS entregue SUMIU",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/work-orders", "host": ["{{baseUrl}}"], "path": ["admin", "work-orders"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const lista = pm.response.json();",
            "const alvo = pm.collectionVariables.get('orderNumber');",
            "pm.test('OS entregue nao aparece mais na fila', () => {",
            "  pm.expect(lista.map(o => o.orderNumber)).to.not.include(alvo);",
            "});",
            "const agora = Number(pm.response.headers.get('X-Total-Count'));",
            "const antes = Number(pm.collectionVariables.get('ativasAntes'));",
            "console.log('Fila ativa: ' + antes + ' → ' + agora);",
            "pm.test('total de ativas caiu em 1', () => pm.expect(agora).to.eql(antes - 1));"
          ] } }]
        },
        {
          "name": "Filtrar por DELIVERED → ela CONTINUA no banco",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/work-orders?status=DELIVERED", "host": ["{{baseUrl}}"], "path": ["admin", "work-orders"], "query": [{ "key": "status", "value": "DELIVERED" }] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const lista = pm.response.json();",
            "const alvo = pm.collectionVariables.get('orderNumber');",
            "pm.test('exclusao e LOGICA: o registro existe e e consultavel', () => {",
            "  pm.expect(lista.map(o => o.orderNumber)).to.include(alvo);",
            "});",
            "console.log('OS ' + alvo + ' segue no banco, com status DELIVERED.');"
          ] } }]
        }
      ]
    },
