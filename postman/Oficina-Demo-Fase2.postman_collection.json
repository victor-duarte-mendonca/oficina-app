            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"licensePlate\": \"ABC1D23\",\n  \"brand\": \"Volkswagen\",\n  \"model\": \"Golf GTI\",\n  \"productionYear\": 2021,\n  \"clientId\": {{clientId}}\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/admin/vehicles", "host": ["{{baseUrl}}"], "path": ["admin", "vehicles"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "const j = pm.response.json();",
            "pm.collectionVariables.set('vehicleId', j.id);",
            "pm.test('vinculado ao cliente criado', () => pm.expect(j.clientId).to.eql(pm.collectionVariables.get('clientId')));"
          ] } }]
        },
        {
          "name": "Criar serviço no catálogo → serviceId",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Troca de oleo e filtro\",\n  \"description\": \"Revisao basica\",\n  \"basePrice\": 180.00,\n  \"estimatedDurationMinutes\": 60\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/admin/services", "host": ["{{baseUrl}}"], "path": ["admin", "services"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('serviceId', pm.response.json().id);"
          ] } }]
        },
        {
          "name": "Criar peça em estoque → partId",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Filtro de oleo\",\n  \"description\": \"Filtro original\",\n  \"unitPrice\": 45.90,\n  \"stockQuantity\": 50,\n  \"unit\": \"UN\",\n  \"minimumStock\": 5,\n  \"partType\": \"PECA\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/admin/parts", "host": ["{{baseUrl}}"], "path": ["admin", "parts"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "const j = pm.response.json();",
            "pm.collectionVariables.set('partId', j.id);",
            "pm.test('estoque acima do minimo', () => pm.expect(j.lowStock).to.be.false);"
          ] } }]
        }
      ]
    },
    {
      "name": "3 — REQUISITO: Abertura de Ordem de Serviço",
      "item": [
        {
          "name": "Criar OS com serviços e peças → 201 + identificação única",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"clientCpfCnpj\": \"{{clientCpf}}\",\n  \"vehicleId\": {{vehicleId}},\n  \"notes\": \"Revisao dos 40.000 km\",\n  \"services\": [\n    { \"serviceItemId\": {{serviceId}}, \"notes\": \"Oleo sintetico\" }\n  ],\n  \"parts\": [\n    { \"partId\": {{partId}}, \"quantity\": 1 }\n  ]\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/admin/work-orders", "host": ["{{baseUrl}}"], "path": ["admin", "work-orders"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "pm.test('header Location aponta para o recurso criado', () => {",
            "  pm.expect(pm.response.headers.get('Location')).to.include('/admin/work-orders/');",
            "});",
            "const j = pm.response.json();",
            "pm.collectionVariables.set('workOrderId', j.id);",
            "pm.collectionVariables.set('orderNumber', j.orderNumber);",
            "console.log('OS criada:', j.orderNumber, '| orcamento R$', j.totalCost);",
            "pm.test('identificacao unica no formato OS-NNNNNN', () => pm.expect(j.orderNumber).to.match(/^OS-\\d{6}$/));",
            "pm.test('status inicial RECEIVED', () => pm.expect(j.status).to.eql('RECEIVED'));",
            "pm.test('orcamento somado pelo dominio: 180,00 + 45,90 = 225,90', () => pm.expect(Number(j.totalCost)).to.eql(225.90));",
            "pm.test('dados do cliente e do veiculo no snapshot', () => {",
            "  pm.expect(j.clientName).to.eql('Victor Duarte');",
            "  pm.expect(j.vehicleLicensePlate).to.eql('ABC1D23');",
            "});"
          ] } }]
        }
      ]
    },
    {
      "name": "4 — Massa para a fila de trabalho",
      "description": "Cria mais 4 OS reaproveitando o mesmo cliente e veículo, deixando uma em cada status ativo — inclusive duas em RECEIVED, para provar o desempate por antiguidade na listagem.",
