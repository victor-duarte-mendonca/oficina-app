  "item": [
    {
      "name": "0 — Saúde do ambiente",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/q/health/live", "host": ["{{baseUrl}}"], "path": ["q", "health", "live"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('status UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
          ] } }]
        },
        {
          "name": "Readiness (inclui checagem do banco)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/q/health/ready", "host": ["{{baseUrl}}"], "path": ["q", "health", "ready"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const j = pm.response.json();",
            "pm.test('status UP', () => pm.expect(j.status).to.eql('UP'));",
            "pm.test('conexao com o banco checada', () => {",
            "  const nomes = j.checks.map(c => c.name).join(' | ');",
            "  console.log('Checks:', nomes);",
            "  pm.expect(nomes.toLowerCase()).to.include('database');",
            "});"
          ] } }]
        }
      ]
    },
    {
      "name": "1 — Autenticação (JWT RSA-256)",
      "item": [
        {
          "name": "Login admin → salva token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{adminUser}}\",\n  \"password\": \"{{adminPass}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const j = pm.response.json();",
            "pm.collectionVariables.set('token', j.token);",
            "pm.test('JWT emitido', () => pm.expect(j.token).to.be.a('string').and.to.have.length.above(100));",
            "pm.test('papel ADMIN', () => pm.expect(j.role).to.eql('ADMIN'));",
            "pm.test('expiracao de 8h (28800s)', () => pm.expect(j.expiresIn).to.eql(28800));"
          ] } }]
        },
        {
          "name": "Login mecanico → salva tokenMecanico",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{mecanicoUser}}\",\n  \"password\": \"{{mecanicoPass}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const j = pm.response.json();",
            "pm.collectionVariables.set('tokenMecanico', j.token);",
            "pm.test('papel MECHANIC', () => pm.expect(j.role).to.eql('MECHANIC'));"
          ] } }]
        }
      ]
    },
    {
      "name": "2 — Cadastros base",
      "item": [
        {
          "name": "Criar cliente (PF) → clientId",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Victor Duarte\",\n  \"cpfCnpj\": \"{{clientCpf}}\",\n  \"clientType\": \"PF\",\n  \"email\": \"cliente@oficina.local\",\n  \"phone\": \"11999998888\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/admin/clients", "host": ["{{baseUrl}}"], "path": ["admin", "clients"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "const j = pm.response.json();",
            "pm.collectionVariables.set('clientId', j.id);",
            "pm.test('CPF normalizado para so digitos (Value Object)', () => pm.expect(j.cpfCnpj).to.eql('52998224725'));"
          ] } }]
