    {
      "name": "5 — REQUISITO: Atualização de status por e-mail",
      "item": [
        {
          "name": "OS principal → IN_DIAGNOSIS",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/work-orders/{{workOrderId}}/start-diagnosis", "host": ["{{baseUrl}}"], "path": ["admin", "work-orders", "{{workOrderId}}", "start-diagnosis"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('RECEIVED → IN_DIAGNOSIS', () => pm.expect(pm.response.json().status).to.eql('IN_DIAGNOSIS'));"
          ] } }]
        },
        {
          "name": "OS principal → AWAITING_APPROVAL (dispara o e-mail)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/work-orders/{{workOrderId}}/send-for-approval", "host": ["{{baseUrl}}"], "path": ["admin", "work-orders", "{{workOrderId}}", "send-for-approval"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const j = pm.response.json();",
            "pm.test('IN_DIAGNOSIS → AWAITING_APPROVAL', () => pm.expect(j.status).to.eql('AWAITING_APPROVAL'));",
            "pm.test('codigo de autorizacao NAO vaza na resposta da API', () => {",
            "  pm.expect(pm.response.text()).to.not.include('approvalToken');",
            "});"
          ] } }]
        },
        {
          "name": "Mailpit — localizar o e-mail do orçamento",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{mailpitUrl}}/api/v1/search?query={{orderNumber}}&limit=10", "host": ["{{mailpitUrl}}"], "path": ["api", "v1", "search"], "query": [{ "key": "query", "value": "{{orderNumber}}" }, { "key": "limit", "value": "10" }] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const j = pm.response.json();",
            "pm.test('e-mail de orcamento entregue ao cliente', () => pm.expect(j.messages.length).to.be.above(0));",
            "const msg = j.messages.find(m => m.Subject.indexOf('aguardando sua aprova') > -1);",
            "pm.test('assunto: orcamento aguardando aprovacao', () => pm.expect(msg, 'e-mail nao encontrado').to.not.be.undefined);",
            "pm.collectionVariables.set('messageId', msg.ID);",
            "console.log('Assunto:', msg.Subject);",
            "console.log('Destinatario:', msg.To[0].Address);",
            "pm.test('enviado ao e-mail do cliente da OS', () => pm.expect(msg.To[0].Address).to.eql('cliente@oficina.local'));"
          ] } }]
        },
        {
          "name": "Mailpit — ler o e-mail e extrair o código de autorização",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{mailpitUrl}}/api/v1/message/{{messageId}}", "host": ["{{mailpitUrl}}"], "path": ["api", "v1", "message", "{{messageId}}"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const corpo = pm.response.json().Text;",
            "console.log('----- CORPO DO E-MAIL -----');",
            "console.log(corpo);",
            "const m = corpo.match(/C[oó]digo de autoriza[cç][aã]o:\\s*(\\S+)/);",
            "pm.test('codigo de autorizacao presente no e-mail', () => pm.expect(m, 'regex nao casou').to.not.be.null);",
            "pm.collectionVariables.set('approvalToken', m[1]);",
            "console.log('>>> Codigo extraido:', m[1]);",
            "pm.test('codigo de 256 bits (43 chars base64url)', () => pm.expect(m[1]).to.have.lengthOf(43));",
            "pm.test('e-mail traz o valor do orcamento', () => pm.expect(corpo).to.include('225.90'));"
          ] } }]
        }
      ]
    },
    {
      "name": "6 — REQUISITO: Consulta de status e aprovação externa",
      "item": [
        {
          "name": "Consultar status da OS (público, sem token)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/public/work-orders/{{orderNumber}}/status", "host": ["{{baseUrl}}"], "path": ["public", "work-orders", "{{orderNumber}}", "status"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK sem autenticacao', () => pm.response.to.have.status(200));",
            "const j = pm.response.json();",
            "console.log('Status ao cliente:', j.statusLabel);",
            "pm.test('rotulo em PT-BR conforme o enunciado', () => pm.expect(j.statusLabel).to.eql('Aguardando Aprovação'));",
            "const bruto = pm.response.text();",
            "pm.test('nao expoe CPF, placa, orcamento nem itens', () => {",
            "  pm.expect(bruto).to.not.include('cpfCnpj');",
            "  pm.expect(bruto).to.not.include('LicensePlate');",
            "  pm.expect(bruto).to.not.include('totalCost');",
            "  pm.expect(bruto).to.not.include('clientName');",
            "});"
          ] } }]
        },
        {
          "name": "Aprovar orçamento (CPF + código do e-mail) → IN_EXECUTION",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"clientCpfCnpj\": \"{{clientCpf}}\",\n  \"approvalToken\": \"{{approvalToken}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/public/work-orders/{{orderNumber}}/approve", "host": ["{{baseUrl}}"], "path": ["public", "work-orders", "{{orderNumber}}", "approve"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const j = pm.response.json();",
            "pm.test('AWAITING_APPROVAL → IN_EXECUTION', () => pm.expect(j.status).to.eql('IN_EXECUTION'));",
            "pm.test('data de aprovacao registrada', () => pm.expect(j.approvedAt).to.not.be.null);"
