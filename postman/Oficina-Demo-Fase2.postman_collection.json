{
  "info": {
    "_postman_id": "8f3c1d20-5a7e-4c11-9b64-0d2f7a6e4c31",
    "name": "Oficina Mecânica — Demo Fase 2 (vídeo)",
    "description": "Collection de demonstração da Fase 2, na ordem exata do roteiro de vídeo.\n\nCada pasta cobre um requisito do enunciado e os testes verificam o comportamento esperado — rode com o **Collection Runner** para ver tudo verde de uma vez, ou requisição a requisição para narrar.\n\n**Pré-requisito:** `docker-compose up -d` na pasta `oficina/`, com a stack em estado limpo (`docker-compose down -v` antes, para a numeração começar em OS-000001).\n\nVariáveis `baseUrl` (http://localhost:8080) e `mailpitUrl` (http://localhost:8025). Para apontar ao ambiente cloud, troque só `baseUrl` — mas lá o canal público de aprovação depende de SMTP real; use o canal administrativo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "mailpitUrl", "value": "http://localhost:8025" },
    { "key": "clientCpf", "value": "529.982.247-25" },
    { "key": "outroCpf", "value": "111.444.777-35" },
    { "key": "adminUser", "value": "admin" },
    { "key": "adminPass", "value": "admin123" },
    { "key": "mecanicoUser", "value": "mecanico" },
    { "key": "mecanicoPass", "value": "mecanico123" },
    { "key": "token", "value": "" },
    { "key": "tokenMecanico", "value": "" },
    { "key": "clientId", "value": "" },
    { "key": "vehicleId", "value": "" },
    { "key": "serviceId", "value": "" },
    { "key": "partId", "value": "" },
    { "key": "workOrderId", "value": "" },
    { "key": "orderNumber", "value": "" },
    { "key": "woId2", "value": "" },
    { "key": "woId3", "value": "" },
    { "key": "woId4", "value": "" },
    { "key": "woId5", "value": "" },
    { "key": "orderNumber4", "value": "" },
    { "key": "messageId", "value": "" },
    { "key": "approvalToken", "value": "" },
    { "key": "ativasAntes", "value": "" }
