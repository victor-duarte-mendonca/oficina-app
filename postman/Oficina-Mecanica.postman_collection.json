{
  "info": {
    "name": "Oficina Mecânica - Tech Challenge Fase 1",
    "_postman_id": "a1b2c3d4-0001-4a5b-8c9d-oficina000001",
    "description": "Collection ordenada para testar a API da Oficina Mecânica (Quarkus).\n\nCOMO USAR:\n1. Suba a stack: docker-compose up --build -d (app em http://localhost:8080).\n2. Rode a collection pelo Collection Runner NA ORDEM das pastas (0 -> 1 -> 2 -> 3 -> 4), OU execute manualmente de cima para baixo.\n3. O token JWT e os IDs (cliente, veículo, serviço, peça, OS) são capturados automaticamente em variáveis de collection pelos scripts de teste.\n\nVariável base: {{baseUrl}} = http://localhost:8080",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "approvalToken", "value": "", "description": "Código de autorização de uso único da OS. Chega apenas por e-mail no momento do envio do orçamento — em execução local, veja no Mailpit (http://localhost:8025)." },
    { "key": "adminUser", "value": "admin" },
    { "key": "adminPass", "value": "admin123" },
    { "key": "mecanicoUser", "value": "mecanico" },
    { "key": "mecanicoPass", "value": "mecanico123" },
    { "key": "token", "value": "" },
    { "key": "tokenMecanico", "value": "" },
    { "key": "clientCpf", "value": "529.982.247-25" },
    { "key": "clientId", "value": "" },
    { "key": "vehicleId", "value": "" },
    { "key": "serviceId", "value": "" },
    { "key": "partId", "value": "" },
    { "key": "workOrderId", "value": "" },
    { "key": "orderNumber", "value": "" }
  ],
  "item": [
    {
      "name": "0 - Auth",
      "item": [
        {
          "name": "Login (admin) -> salva token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login 200', () => pm.response.code === 200);",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('token', b.token);",
                  "pm.test('token recebido', () => !!b.token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\"username\": \"{{adminUser}}\", \"password\": \"{{adminPass}}\"}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": [ "{{baseUrl}}" ], "path": [ "auth", "login" ] }
          }
        }
      ]
    },
    {
      "name": "1 - Setup (cria entidades)",
      "item": [
        {
          "name": "Criar Cliente (PF) -> salva clientId",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('cliente 201', () => pm.response.code === 201);",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('clientId', b.id);",
                  "pm.collectionVariables.set('clientCpf', b.cpfCnpj);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\"name\": \"Maria Oliveira\", \"cpfCnpj\": \"{{clientCpf}}\", \"clientType\": \"PF\", \"email\": \"maria@email.com\", \"phone\": \"11988887777\"}" },
            "url": { "raw": "{{baseUrl}}/admin/clients", "host": [ "{{baseUrl}}" ], "path": [ "admin", "clients" ] }
          }
        },
        {
          "name": "Criar Veículo -> salva vehicleId",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('veículo 201', () => pm.response.code === 201);",
                  "pm.collectionVariables.set('vehicleId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\"licensePlate\": \"ABC1D23\", \"brand\": \"Fiat\", \"model\": \"Mobi\", \"productionYear\": 2022, \"clientId\": {{clientId}}}" },
            "url": { "raw": "{{baseUrl}}/admin/vehicles", "host": [ "{{baseUrl}}" ], "path": [ "admin", "vehicles" ] }
          }
        },
        {
          "name": "Criar Serviço -> salva serviceId",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('serviço 201', () => pm.response.code === 201);",
                  "pm.collectionVariables.set('serviceId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\"name\": \"Troca de Óleo\", \"description\": \"Inclui filtro\", \"basePrice\": 120.00, \"estimatedDurationMinutes\": 30}" },
            "url": { "raw": "{{baseUrl}}/admin/services", "host": [ "{{baseUrl}}" ], "path": [ "admin", "services" ] }
          }
        },
        {
          "name": "Criar Peça -> salva partId",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('peça 201', () => pm.response.code === 201);",
                  "pm.collectionVariables.set('partId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\"name\": \"Óleo 5W30\", \"description\": \"1L\", \"unitPrice\": 45.90, \"stockQuantity\": 50, \"unit\": \"L\", \"minimumStock\": 10, \"partType\": \"INSUMO\"}" },
            "url": { "raw": "{{baseUrl}}/admin/parts", "host": [ "{{baseUrl}}" ], "path": [ "admin", "parts" ] }
          }
        }
      ]
    },
    {
      "name": "2 - Ordem de Serviço (fluxo)",
      "item": [
        {
          "name": "Criar OS -> salva workOrderId e orderNumber",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('OS 201', () => pm.response.code === 201);",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('workOrderId', b.id);",
                  "pm.collectionVariables.set('orderNumber', b.orderNumber);",
                  "pm.test('status RECEIVED', () => b.status === 'RECEIVED');",
                  "pm.test('orçamento calculado', () => b.totalCost > 0);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\"clientCpfCnpj\": \"{{clientCpf}}\", \"vehicleId\": {{vehicleId}}, \"notes\": \"Revisão dos 10.000 km\", \"services\": [{\"serviceItemId\": {{serviceId}}, \"notes\": \"com filtro\"}], \"parts\": [{\"partId\": {{partId}}, \"quantity\": 2}]}" },
            "url": { "raw": "{{baseUrl}}/admin/work-orders", "host": [ "{{baseUrl}}" ], "path": [ "admin", "work-orders" ] }
          }
        },
        {
          "name": "Adicionar Peça à OS",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [ "pm.test('add peça 200', () => pm.response.code === 200);" ] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\"partId\": {{partId}}, \"quantity\": 1}" },
            "url": { "raw": "{{baseUrl}}/admin/work-orders/{{workOrderId}}/parts", "host": [ "{{baseUrl}}" ], "path": [ "admin", "work-orders", "{{workOrderId}}", "parts" ] }
          }
        },
        {
          "name": "Iniciar Diagnóstico (RECEIVED -> IN_DIAGNOSIS)",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [ "pm.test('200', () => pm.response.code === 200);", "pm.test('IN_DIAGNOSIS', () => pm.response.json().status === 'IN_DIAGNOSIS');" ] }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/work-orders/{{workOrderId}}/start-diagnosis", "host": [ "{{baseUrl}}" ], "path": [ "admin", "work-orders", "{{workOrderId}}", "start-diagnosis" ] }
          }
        },
        {
          "name": "Enviar para Aprovação (IN_DIAGNOSIS -> AWAITING_APPROVAL)",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [ "pm.test('200', () => pm.response.code === 200);", "pm.test('AWAITING_APPROVAL', () => pm.response.json().status === 'AWAITING_APPROVAL');" ] }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/work-orders/{{workOrderId}}/send-for-approval", "host": [ "{{baseUrl}}" ], "path": [ "admin", "work-orders", "{{workOrderId}}", "send-for-approval" ] }
          }
        },
        {
          "name": "Público - Consultar Status (sem token)",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [ "pm.test('200', () => pm.response.code === 200);", "pm.test('sem dados pessoais', () => !pm.response.text().includes('clientCpfCnpj'));" ] }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/public/work-orders/{{orderNumber}}/status", "host": [ "{{baseUrl}}" ], "path": [ "public", "work-orders", "{{orderNumber}}", "status" ] }
          }
        },
        {
          "name": "Público - Aprovar Orçamento (CPF do dono + código do e-mail)",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [ "pm.test('200', () => pm.response.code === 200);", "pm.test('IN_EXECUTION', () => pm.response.json().status === 'IN_EXECUTION');" ] }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "description": "Preencha a variável approvalToken com o código de autorização recebido por e-mail (em execução local, visível no Mailpit: http://localhost:8025). O código vale para uma única decisão e é invalidado no uso.",
            "body": { "mode": "raw", "raw": "{\"clientCpfCnpj\": \"{{clientCpf}}\", \"approvalToken\": \"{{approvalToken}}\"}" },
            "url": { "raw": "{{baseUrl}}/public/work-orders/{{orderNumber}}/approve", "host": [ "{{baseUrl}}" ], "path": [ "public", "work-orders", "{{orderNumber}}", "approve" ] }
          }
        },
        {
          "name": "Público - Reaproveitar o mesmo código (422)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('422 - código de uso único já consumido', () => pm.response.code === 422);" ] } } ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\"clientCpfCnpj\": \"{{clientCpf}}\", \"approvalToken\": \"{{approvalToken}}\"}" },
            "url": { "raw": "{{baseUrl}}/public/work-orders/{{orderNumber}}/approve", "host": [ "{{baseUrl}}" ], "path": [ "public", "work-orders", "{{orderNumber}}", "approve" ] }
          }
        },
        {
          "name": "Concluir Execução (IN_EXECUTION -> FINISHED)",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [ "pm.test('200', () => pm.response.code === 200);", "pm.test('FINISHED', () => pm.response.json().status === 'FINISHED');" ] }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/work-orders/{{workOrderId}}/complete", "host": [ "{{baseUrl}}" ], "path": [ "admin", "work-orders", "{{workOrderId}}", "complete" ] }
          }
        },
        {
          "name": "Registrar Entrega (FINISHED -> DELIVERED)",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [ "pm.test('200', () => pm.response.code === 200);", "pm.test('DELIVERED', () => pm.response.json().status === 'DELIVERED');" ] }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/work-orders/{{workOrderId}}/deliver", "host": [ "{{baseUrl}}" ], "path": [ "admin", "work-orders", "{{workOrderId}}", "deliver" ] }
          }
        }
      ]
    },
    {
      "name": "3 - Consultas & Métricas",
      "item": [
        {
          "name": "Listar OS (paginado)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/work-orders?page=0&size=20", "host": [ "{{baseUrl}}" ], "path": [ "admin", "work-orders" ], "query": [ { "key": "page", "value": "0" }, { "key": "size", "value": "20" } ] }
          }
        },
        {
          "name": "Buscar OS por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/work-orders/{{workOrderId}}", "host": [ "{{baseUrl}}" ], "path": [ "admin", "work-orders", "{{workOrderId}}" ] }
          }
        },
        {
          "name": "Buscar OS por número",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/work-orders/number/{{orderNumber}}", "host": [ "{{baseUrl}}" ], "path": [ "admin", "work-orders", "number", "{{orderNumber}}" ] }
          }
        },
        {
          "name": "Listar Clientes",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/clients?page=0&size=20", "host": [ "{{baseUrl}}" ], "path": [ "admin", "clients" ], "query": [ { "key": "page", "value": "0" }, { "key": "size", "value": "20" } ] }
          }
        },
        {
          "name": "Listar Veículos do Cliente",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/vehicles/client/{{clientId}}", "host": [ "{{baseUrl}}" ], "path": [ "admin", "vehicles", "client", "{{clientId}}" ] }
          }
        },
        {
          "name": "Serviços Ativos",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/services/active", "host": [ "{{baseUrl}}" ], "path": [ "admin", "services", "active" ] }
          }
        },
        {
          "name": "Peças com Estoque Baixo",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/parts/low-stock", "host": [ "{{baseUrl}}" ], "path": [ "admin", "parts", "low-stock" ] }
          }
        },
        {
          "name": "Métricas (somente ADMIN)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('200', () => pm.response.code === 200);" ] } }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/metrics", "host": [ "{{baseUrl}}" ], "path": [ "admin", "metrics" ] }
          }
        }
      ]
    },
    {
      "name": "4 - Cenários de Erro",
      "item": [
        {
          "name": "Login inválido (401)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('401', () => pm.response.code === 401);" ] } } ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\"username\": \"admin\", \"password\": \"senhaerrada\"}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": [ "{{baseUrl}}" ], "path": [ "auth", "login" ] }
          }
        },
        {
          "name": "Acesso sem token (401)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('401', () => pm.response.code === 401);" ] } } ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/clients", "host": [ "{{baseUrl}}" ], "path": [ "admin", "clients" ] }
          }
        },
        {
          "name": "Cliente com CPF inválido (400)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('400', () => pm.response.code === 400);" ] } } ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\"name\": \"Teste\", \"cpfCnpj\": \"123.456.789-00\", \"clientType\": \"PF\"}" },
            "url": { "raw": "{{baseUrl}}/admin/clients", "host": [ "{{baseUrl}}" ], "path": [ "admin", "clients" ] }
          }
        },
        {
          "name": "Cliente duplicado (422)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('422', () => pm.response.code === 422);" ] } } ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\"name\": \"Maria Duplicada\", \"cpfCnpj\": \"{{clientCpf}}\", \"clientType\": \"PF\"}" },
            "url": { "raw": "{{baseUrl}}/admin/clients", "host": [ "{{baseUrl}}" ], "path": [ "admin", "clients" ] }
          }
        },
        {
          "name": "Veículo com cliente inexistente (404)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('404', () => pm.response.code === 404);" ] } } ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\"licensePlate\": \"XYZ9B88\", \"brand\": \"VW\", \"model\": \"Gol\", \"productionYear\": 2020, \"clientId\": 999999}" },
            "url": { "raw": "{{baseUrl}}/admin/vehicles", "host": [ "{{baseUrl}}" ], "path": [ "admin", "vehicles" ] }
          }
        },
        {
          "name": "Recurso não encontrado (404)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('404', () => pm.response.code === 404);" ] } } ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/clients/999999", "host": [ "{{baseUrl}}" ], "path": [ "admin", "clients", "999999" ] }
          }
        },
        {
          "name": "Ajuste de estoque insuficiente (422)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('422', () => pm.response.code === 422);" ] } } ],
          "request": {
            "method": "PATCH",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/parts/{{partId}}/stock?adjustment=-999999", "host": [ "{{baseUrl}}" ], "path": [ "admin", "parts", "{{partId}}", "stock" ], "query": [ { "key": "adjustment", "value": "-999999" } ] }
          }
        },
        {
          "name": "Transição inválida - approve em OS entregue (422)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('422', () => pm.response.code === 422);" ] } } ],
          "request": {
            "method": "PATCH",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/work-orders/{{workOrderId}}/approve", "host": [ "{{baseUrl}}" ], "path": [ "admin", "work-orders", "{{workOrderId}}", "approve" ] }
          }
        },
        {
          "name": "Público aprovar com CPF errado (404)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('404', () => pm.response.code === 404);" ] } } ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\"clientCpfCnpj\": \"111.444.777-35\", \"approvalToken\": \"{{approvalToken}}\"}" },
            "url": { "raw": "{{baseUrl}}/public/work-orders/{{orderNumber}}/approve", "host": [ "{{baseUrl}}" ], "path": [ "public", "work-orders", "{{orderNumber}}", "approve" ] }
          }
        },
        {
          "name": "Público aprovar sem código de autorização (400)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('400 - approvalToken obrigatório', () => pm.response.code === 400);" ] } } ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\"clientCpfCnpj\": \"{{clientCpf}}\"}" },
            "url": { "raw": "{{baseUrl}}/public/work-orders/{{orderNumber}}/approve", "host": [ "{{baseUrl}}" ], "path": [ "public", "work-orders", "{{orderNumber}}", "approve" ] }
          }
        },
        {
          "name": "Público aprovar com código chutado (404)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('404 - não revela se a OS existe', () => pm.response.code === 404);" ] } } ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\"clientCpfCnpj\": \"{{clientCpf}}\", \"approvalToken\": \"codigo-chutado\"}" },
            "url": { "raw": "{{baseUrl}}/public/work-orders/{{orderNumber}}/approve", "host": [ "{{baseUrl}}" ], "path": [ "public", "work-orders", "{{orderNumber}}", "approve" ] }
          }
        },
        {
          "name": "Login (mecanico) -> salva tokenMecanico",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('200', () => pm.response.code === 200);", "pm.collectionVariables.set('tokenMecanico', pm.response.json().token);" ] } } ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\"username\": \"{{mecanicoUser}}\", \"password\": \"{{mecanicoPass}}\"}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": [ "{{baseUrl}}" ], "path": [ "auth", "login" ] }
          }
        },
        {
          "name": "Mecânico criando peça (403)",
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('403', () => pm.response.code === 403);" ] } } ],
          "request": {
            "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{tokenMecanico}}", "type": "string" } ] },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\"name\": \"Peça Proibida\", \"unitPrice\": 10.0, \"stockQuantity\": 1, \"unit\": \"UN\"}" },
            "url": { "raw": "{{baseUrl}}/admin/parts", "host": [ "{{baseUrl}}" ], "path": [ "admin", "parts" ] }
          }
        }
      ]
    }
  ]
}
