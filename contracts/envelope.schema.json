{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oficina.local/contracts/envelope.schema.json",
  "title": "Envelope comum das mensagens da Saga (spec 03 §2)",
  "type": "object",
  "required": ["messageId", "type", "version", "kind", "workOrderId", "occurredAt", "payload"],
  "additionalProperties": false,
  "properties": {
    "messageId": { "type": "string", "format": "uuid" },
    "type": { "type": "string", "pattern": "^[A-Z][A-Za-z]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "kind": { "enum": ["COMMAND", "EVENT", "INFO"] },
    "sagaId": { "type": ["string", "null"], "format": "uuid" },
    "workOrderId": { "type": "integer", "minimum": 1 },
    "orderNumber": { "type": ["string", "null"], "pattern": "^OS-\\d{6,}$" },
    "correlationId": { "type": ["string", "null"], "maxLength": 128 },
    "causationId": { "type": ["string", "null"], "format": "uuid" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "traceparent": { "type": ["string", "null"], "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$" },
    "payload": { "type": "object" }
  },
  "$defs": {
    "money": { "type": "string", "pattern": "^\\d{1,10}\\.\\d{2}$", "description": "Valor decimal com 2 casas, como string (evita ponto flutuante)." },
    "reason": { "type": "string", "minLength": 1, "maxLength": 300 },
    "itemKind": { "enum": ["PART", "SERVICE"] },
    "vehicle": {
      "type": "object",
      "required": ["brand", "model", "plate"],
      "additionalProperties": false,
      "properties": {
        "brand": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "plate": { "type": "string", "minLength": 7, "maxLength": 8 }
      }
    }
  }
}
